# URL publique du site (utilisée pour les balises canonical, hreflang, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://eternatech.net

# --- Formulaire de contact (§ 4 et § 11) ---
# Deux voies d'envoi possibles. Laisser les deux vides en développement : les
# messages sont alors seulement journalisés côté serveur (aucun e-mail envoyé).
#
# 1) SMTP — reprend la configuration de l'API actuelle d'eternatech.net.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
#
# 2) Resend, en alternative au SMTP.
RESEND_API_KEY=
#
# Routage des destinataires, tel qu'implémenté sur le site actuel : les sujets
# « Demande de devis » et « Demande de démonstration… » partent vers la boîte
# commerciale, tout le reste vers la boîte de contact.
CONTACT_EMAIL_TO=contact@eternatech.net
SERVICE_EMAIL_TO=service@eternatech.net
CONTACT_EMAIL_FROM=site@eternatech.net

# --- Anti-spam Cloudflare Turnstile (§ 4) ---
# Si la clé secrète est absente, la vérification est ignorée (mode développement).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Newsletter (§ 10.5) — Brevo ---
BREVO_API_KEY=
BREVO_LIST_ID=

# --- Suivi (§ 11) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
